# Copy to .env, which git ignores. Never commit real values.

# NEAR AI Cloud key, from https://cloud.near.ai. Stored as an OutLayer secret for the checker.
NEAR_AI_API_KEY=your-near-ai-api-key

# 32 random bytes as hex: openssl rand -hex 32
# Stored as an OutLayer secret. Agents only ever get the matching public key.
CHECKER_SECRET_KEY=replace-with-64-hex-characters

# Where sealed invoices are stored. The checker appends the request's blob ID.
BLOB_BASE_URL=https://example.com/blobs
